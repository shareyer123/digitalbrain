{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "node \"$HOME/.claude/hooks/raw-guard.cjs\"", "timeout": 5 } ] },
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/hooks/git-guard.sh\"", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "node \"$HOME/.claude/hooks/work-watch.cjs\"" },
        { "type": "command", "command": "node \"$HOME/.claude/hooks/hook-lint.cjs\"", "timeout": 15 } ] }
    ],
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/hooks/memory-size-check.sh\"", "timeout": 10 },
        { "type": "command", "command": "node \"$HOME/.claude/hooks/style-context.cjs\"", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/hooks/devlog-watch.sh\" Stop", "timeout": 10,
          "statusMessage": "Checking DevLog is current..." } ] }
    ],
    "PreCompact": [
      { "hooks": [
        { "type": "command", "command": "bash \"$HOME/.claude/hooks/devlog-watch.sh\" PreCompact", "timeout": 10 } ] }
    ]
  }
}
