#!/usr/bin/env bash
# Installed into every repo by install.sh / git-checkpoint.sh (new repos get it via init.templateDir).
# Scans STAGED content for secrets and PII-shaped strings. Blocks the commit on a hit.
# Bypass deliberately with: git commit --no-verify   (and say so in the DevLog).
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
[ -n "$files" ] || exit 0
# 1. filenames that are never committed
bad=$(printf '%s\n' "$files" | grep -iE '(^|/)\.env($|\.)|\.pem$|\.key$|id_rsa|id_ed25519|credentials\.json|(^|/)secrets?\.(json|ya?ml|toml)$|\.p12$|\.pfx$' || true)
if [ -n "$bad" ]; then echo "pre-commit: refusing secret-looking files:"; printf '  %s\n' $bad; fail=1; fi
# 2. secret-shaped strings in the staged diff (added lines only)
added=$(git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+')
pat='ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|xox[abp]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|(api[_-]?key|secret|token|password) *[=:] *["'"'"'][A-Za-z0-9_/+=-]{16,}'
hits=$(printf '%s\n' "$added" | grep -nE "$pat" || true)
if [ -n "$hits" ]; then echo "pre-commit: secret-shaped string in staged changes:"; printf '%s\n' "$hits" | cut -c1-120; fail=1; fi
# 3. PII-shaped strings: SSN, 16-digit card numbers
pii=$(printf '%s\n' "$added" | grep -nE '[0-9]{3}-[0-9]{2}-[0-9]{4}|(4[0-9]{3}|5[1-5][0-9]{2}|3[47][0-9]{2})[ -]?[0-9]{4}[ -]?[0-9]{4}[ -]?[0-9]{4}' || true)
if [ -n "$pii" ]; then echo "pre-commit: PII-shaped string (SSN / card number) in staged changes:"; printf '%s\n' "$pii" | cut -c1-120; fail=1; fi
if [ "$fail" -ne 0 ]; then echo "pre-commit: commit blocked. Fix it, or 'git commit --no-verify' if this is a false positive."; exit 1; fi
exit 0
